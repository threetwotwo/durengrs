rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Farm cultivars catalog
    match /variants/{code} {
      allow read, write: if true;
    }

    // Orchard trees inventory
    match /trees/{treeId} {
      allow read, write: if true;
    }

    // Field inspection reports
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // User access authorization list (for future Google Sign-In phase)
    match /users/{email} {
      allow read, write: if true;
    }

    // Audit log of tree edits (written by the webapp and the WhatsApp bot)
    match /treeEdits/{id} {
      allow read, write: if true;
    }

    // Recurring routines (fertilizer, sprays, pruning) and the log of what was applied
    match /treatmentPlans/{id} {
      allow read, write: if true;
    }
    match /treatments/{id} {
      allow read, write: if true;
    }

    // Farm notes per Guide topic (what this farm has learned), keyed by topic id
    match /guideNotes/{topicId} {
      allow read, write: if true;
    }

    // Farm records for the Guide: harvests, one-off season tasks, daily rain, lab results, weekly review
    match /harvests/{id} {
      allow read, write: if true;
    }
    match /seasonTasks/{id} {
      allow read, write: if true;
    }
    match /weather/{date} {
      allow read, write: if true;
    }
    match /labResults/{id} {
      allow read, write: if true;
    }
    match /farmMeta/{id} {
      allow read, write: if true;
    }

    // One flowering date per block, used for the harvest outlook
    match /harvestCycles/{block} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
