rules_version = '2';
// Who may read and write what (the webapp: Google sign-in, src/lib/auth.ts). Roles are in users/{email}:
//   admin  everything
//   shop   the shop team's QC page: read trees, varieties and harvests; read and write gradings (treeGrades)
// Anyone else, signed in or not: nothing. The WhatsApp bot, the daily summary and the GitHub workflows use the
// service account (Admin SDK), which these rules don't apply to: workers' WhatsApp reports are not affected.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function member() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email.lower()));
    }
    function role() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower()))
        ? member().data.get('role', '')
        : '';
    }
    function isAdmin() {
      return role() == 'admin';
    }
    function isShop() {
      return role() == 'shop';
    }

    // Admins: every collection.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Everyone signed in reads their own access record (the webapp shows what they may open).
    match /users/{email} {
      allow get: if signedIn() && request.auth.token.email.lower() == email;
    }

    // The shop team: what the QC page lists (the fruits picked, their trees and varieties), read only.
    match /trees/{id} {
      allow read: if isShop();
    }
    match /variants/{code} {
      allow read: if isShop();
    }
    match /harvests/{id} {
      allow read: if isShop();
    }
    // ...and the gradings: read, and write one fruit's grading (its scores, photos, note, who), never delete.
    match /treeGrades/{id} {
      allow read: if isShop();
      allow create, update: if isShop()
        && request.resource.data.keys().hasOnly(['treeId', 'date', 'qc', 'grade', 'note', 'photos', 'fruitKey', 'fruitCode', 'weightG', 'from', 'by', 'at', 'updatedAt', 'scheme'])
        && request.resource.data.treeId is string
        && request.resource.data.qc is map;
    }
  }
}
