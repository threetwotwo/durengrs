GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json
STORAGE_BUCKET=your-project-id.firebasestorage.app

PORT=3000
VERIFY_TOKEN=choose_any_random_string
WHATSAPP_TOKEN=your_whatsapp_token
PHONE_NUMBER_ID=your_phone_number_id
FLOW_ID=your_tree_report_flow_id
FARM_FLOW_ID=your_farm_flow_id

FLOW_PRIVATE_KEY_FILE=./private_key.pem

# Gemini reads report photos + words (Google AI Studio key; without it reports still save, with the word-only reading).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only for a Vertex AI express key: GEMINI_ENDPOINT=vertex
GEMINI_ENDPOINT=
# How long to wait for Gemini, in milliseconds (default 40000).
GEMINI_TIMEOUT_MS=
