{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "TREE_LOOKUP": [
      "MENU"
    ],
    "MENU": [
      "REPORT",
      "PANEN_MENU"
    ],
    "REPORT": [
      "DONE"
    ],
    "PANEN_MENU": [
      "BLOOM",
      "COUNT",
      "HARVEST_A",
      "EDIT_TREE"
    ],
    "BLOOM": [
      "DONE"
    ],
    "COUNT": [
      "DONE"
    ],
    "HARVEST_A": [
      "HARVEST_B"
    ],
    "HARVEST_B": [
      "DONE"
    ],
    "EDIT_TREE": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "TREE_LOOKUP",
      "title": "Info Pohon",
      "data": {
        "title": {
          "type": "string",
          "__example__": "Pohon A1 · MK"
        },
        "status": {
          "type": "string",
          "__example__": "🟢 Sehat"
        },
        "measurements": {
          "type": "string",
          "__example__": "- Lebar kanopi: **520 cm**\n- Lingkar batang: **43 cm**"
        },
        "notes": {
          "type": "string",
          "__example__": "—"
        },
        "last_meta": {
          "type": "string",
          "__example__": "2 Okt 11.54"
        },
        "last_text": {
          "type": "string",
          "__example__": "Daun terlihat baik"
        },
        "last_photos": {
          "type": "string",
          "__example__": "📷 [Foto 1](https://example.com/1.jpg)"
        },
        "menu_title": {
          "type": "string",
          "__example__": "Pohon A1 · MK · Blok A"
        },
        "suggestion": {
          "type": "string",
          "__example__": "Saran: hitung buah di pohon (terakhir dihitung 16 hari lalu). Pilih Panen & Data Pohon."
        },
        "has_suggestion": {
          "type": "boolean",
          "__example__": true
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.title}"
          },
          {
            "type": "TextBody",
            "text": "${data.status}",
            "font-weight": "bold"
          },
          {
            "type": "TextSubheading",
            "text": "📏 Pengukuran"
          },
          {
            "type": "TextBody",
            "text": "${data.measurements}",
            "markdown": true
          },
          {
            "type": "TextSubheading",
            "text": "📝 Catatan pohon"
          },
          {
            "type": "TextBody",
            "text": "${data.notes}"
          },
          {
            "type": "TextSubheading",
            "text": "🕒 Laporan terakhir"
          },
          {
            "type": "TextCaption",
            "text": "${data.last_meta}"
          },
          {
            "type": "TextBody",
            "text": "${data.last_text}"
          },
          {
            "type": "TextBody",
            "text": "${data.last_photos}",
            "markdown": true
          },
          {
            "type": "Footer",
            "label": "Buat Laporan",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "MENU"
              },
              "payload": {
                "menu_title": "${data.menu_title}",
                "suggestion": "${data.suggestion}",
                "has_suggestion": "${data.has_suggestion}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "MENU",
      "title": "Laporan Pohon",
      "data": {
        "menu_title": {
          "type": "string",
          "__example__": "Pohon A1 · MK · Blok A"
        },
        "suggestion": {
          "type": "string",
          "__example__": "Saran: hitung buah di pohon."
        },
        "has_suggestion": {
          "type": "boolean",
          "__example__": true
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "menu_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.menu_title}"
              },
              {
                "type": "TextBody",
                "text": "${data.suggestion}",
                "visible": "${data.has_suggestion}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "choice",
                "label": "Apa yang ingin Anda laporkan?",
                "required": true,
                "data-source": [
                  {
                    "id": "issue",
                    "title": "Laporan Masalah",
                    "description": "Daun, batang, hama, atau kondisi pohon. Bisa dengan foto."
                  },
                  {
                    "id": "harvest",
                    "title": "Panen & Data Pohon",
                    "description": "Bunga, hitung buah, catat panen, dan ukuran pohon."
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Lanjut",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "choice": "${form.choice}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "REPORT",
      "title": "Laporan Masalah",
      "data": {
        "report_title": {
          "type": "string",
          "__example__": "Laporan untuk A1"
        },
        "condition_caption": {
          "type": "string",
          "__example__": "Kondisi saat ini: Sehat"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "report_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.report_title}"
              },
              {
                "type": "TextCaption",
                "text": "${data.condition_caption}"
              },
              {
                "type": "TextBody",
                "text": "Isi seperlunya. Foto atau keterangan, salah satu wajib ada."
              },
              {
                "type": "TextSubheading",
                "text": "1. Jenis masalah (boleh dilewati)"
              },
              {
                "type": "CheckboxGroup",
                "name": "problem_types",
                "label": "Apa yang Anda lihat?",
                "required": false,
                "data-source": [
                  {
                    "id": "leaf",
                    "title": "Daun / tunas"
                  },
                  {
                    "id": "trunk",
                    "title": "Batang / getah"
                  },
                  {
                    "id": "borer",
                    "title": "Lubang penggerek"
                  },
                  {
                    "id": "pest",
                    "title": "Hama"
                  },
                  {
                    "id": "fruit",
                    "title": "Buah busuk / rontok"
                  },
                  {
                    "id": "other",
                    "title": "Lainnya"
                  }
                ]
              },
              {
                "type": "TextSubheading",
                "text": "2. Foto"
              },
              {
                "type": "TextCaption",
                "text": "Foto dari dekat dan foto seluruh pohon membantu pemilik menilai."
              },
              {
                "type": "PhotoPicker",
                "name": "photos",
                "label": "Ambil atau pilih foto",
                "photo-source": "camera_gallery",
                "max-file-size-kb": 10240,
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 3
              },
              {
                "type": "TextSubheading",
                "text": "3. Keterangan"
              },
              {
                "type": "TextArea",
                "name": "description",
                "label": "Apa yang Anda lihat atau lakukan?",
                "label-variant": "large",
                "helper-text": "Wajib diisi jika tidak ada foto",
                "required": false,
                "max-length": 600
              },
              {
                "type": "TextSubheading",
                "text": "4. Kondisi pohon"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "condition",
                "label": "Kondisi pohon sekarang",
                "description": "Pilih \"Tidak ada perubahan\" jika kondisinya sama. Untuk Darurat, foto wajib.",
                "required": false,
                "data-source": [
                  {
                    "id": "unchanged",
                    "title": "Tidak ada perubahan"
                  },
                  {
                    "id": "healthy",
                    "title": "🟢 Sehat"
                  },
                  {
                    "id": "minor",
                    "title": "🟠 Masalah ringan"
                  },
                  {
                    "id": "emergency",
                    "title": "🔴 Darurat"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Kirim Laporan",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "problem_types": "${form.problem_types}",
                    "condition": "${form.condition}",
                    "description": "${form.description}",
                    "photos": "${form.photos}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "PANEN_MENU",
      "title": "Panen & Data Pohon",
      "data": {
        "panen_title": {
          "type": "string",
          "__example__": "Panen & Data Pohon · A1 · MK · Blok A"
        },
        "panen_hint": {
          "type": "string",
          "__example__": "Saran: hitung buah di pohon."
        },
        "has_hint": {
          "type": "boolean",
          "__example__": true
        },
        "stage_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "bloom",
              "title": "Mulai berbunga",
              "description": "Bunga pertama mekar."
            },
            {
              "id": "harvest",
              "title": "Catat panen",
              "description": "Jumlah buah, berat, dan kelas mutu."
            },
            {
              "id": "tree",
              "title": "Ubah data pohon",
              "description": "Kanopi, lingkar batang, catatan."
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "panen_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.panen_title}"
              },
              {
                "type": "TextBody",
                "text": "${data.panen_hint}",
                "visible": "${data.has_hint}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "stage",
                "label": "Pilih laporan",
                "required": true,
                "data-source": "${data.stage_options}"
              },
              {
                "type": "Footer",
                "label": "Lanjut",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "stage": "${form.stage}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BLOOM",
      "title": "Mulai Berbunga",
      "data": {
        "bloom_title": {
          "type": "string",
          "__example__": "Mulai berbunga · A1"
        },
        "min_date": {
          "type": "string",
          "__example__": "2026-08-01"
        },
        "max_date": {
          "type": "string",
          "__example__": "2026-10-04"
        },
        "needs_confirm": {
          "type": "boolean",
          "__example__": false
        },
        "warned": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "bloom_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.bloom_title}"
              },
              {
                "type": "TextBody",
                "text": "Catat tanggal bunga pertama mekar. Tanggal ini dipakai untuk menghitung kapan buah siap dipanen."
              },
              {
                "type": "DatePicker",
                "name": "date",
                "label": "Tanggal bunga mekar",
                "required": true,
                "helper-text": "Pilih hari bunga mulai mekar, bukan saat kuncup.",
                "min-date": "${data.min_date}",
                "max-date": "${data.max_date}"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "part",
                "label": "Bagian pohon yang berbunga",
                "description": "Jika hanya sebagian dahan yang berbunga, pilih bagiannya. Dahan lain yang berbunga di hari berbeda dilaporkan lagi nanti.",
                "required": true,
                "data-source": [
                  {
                    "id": "whole",
                    "title": "Seluruh pohon"
                  },
                  {
                    "id": "lower",
                    "title": "Dahan bawah"
                  },
                  {
                    "id": "middle",
                    "title": "Dahan tengah"
                  },
                  {
                    "id": "upper",
                    "title": "Dahan atas"
                  },
                  {
                    "id": "some",
                    "title": "Sebagian dahan"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Foto bunga, boleh kosong. Maksimal 3 foto."
              },
              {
                "type": "PhotoPicker",
                "name": "photos",
                "label": "Foto bunga (boleh kosong)",
                "photo-source": "camera_gallery",
                "max-file-size-kb": 10240,
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 3
              },
              {
                "type": "TextInput",
                "name": "note",
                "label": "Catatan (boleh kosong)",
                "label-variant": "large",
                "input-type": "text",
                "required": false,
                "max-chars": 200
              },
              {
                "type": "OptIn",
                "name": "confirm",
                "label": "Ya, sudah benar",
                "required": false,
                "visible": "${data.needs_confirm}"
              },
              {
                "type": "Footer",
                "label": "Simpan",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "date": "${form.date}",
                    "part": "${form.part}",
                    "photos": "${form.photos}",
                    "note": "${form.note}",
                    "confirm": "${form.confirm}",
                    "warned": "${data.warned}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "COUNT",
      "title": "Hitung",
      "data": {
        "count_title": {
          "type": "string",
          "__example__": "Hitung Buah di Pohon · A1"
        },
        "count_help": {
          "type": "string",
          "__example__": "Hitung buah yang masih menggantung di pohon."
        },
        "count_label": {
          "type": "string",
          "__example__": "Jumlah buah di pohon"
        },
        "stage": {
          "type": "string",
          "__example__": "onTree"
        },
        "wave_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "2026-06-10",
              "title": "10 Jun 2026 · Seluruh pohon"
            }
          ]
        },
        "init_values": {
          "type": "object",
          "properties": {
            "wave": {
              "type": "string"
            }
          },
          "__example__": {
            "wave": "2026-06-10"
          }
        },
        "needs_confirm": {
          "type": "boolean",
          "__example__": false
        },
        "warned": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "count_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.count_title}"
              },
              {
                "type": "TextBody",
                "text": "${data.count_help}"
              },
              {
                "type": "Dropdown",
                "name": "wave",
                "label": "Gelombang bunga",
                "required": true,
                "data-source": "${data.wave_options}"
              },
              {
                "type": "TextInput",
                "name": "count",
                "label": "${data.count_label}",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Tulis angka bulat, contoh: 120. Perkiraan boleh.",
                "required": true
              },
              {
                "type": "TextCaption",
                "text": "Foto pohon atau buah, boleh kosong. Maksimal 3 foto."
              },
              {
                "type": "PhotoPicker",
                "name": "photos",
                "label": "Foto (boleh kosong)",
                "photo-source": "camera_gallery",
                "max-file-size-kb": 10240,
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 3
              },
              {
                "type": "TextInput",
                "name": "note",
                "label": "Catatan (boleh kosong)",
                "label-variant": "large",
                "input-type": "text",
                "required": false,
                "max-chars": 200
              },
              {
                "type": "OptIn",
                "name": "confirm",
                "label": "Ya, angka sudah benar",
                "required": false,
                "visible": "${data.needs_confirm}"
              },
              {
                "type": "Footer",
                "label": "Simpan Hitungan",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "stage": "${data.stage}",
                    "wave": "${form.wave}",
                    "count": "${form.count}",
                    "photos": "${form.photos}",
                    "note": "${form.note}",
                    "confirm": "${form.confirm}",
                    "warned": "${data.warned}"
                  }
                }
              }
            ],
            "init-values": "${data.init_values}"
          }
        ]
      }
    },
    {
      "id": "HARVEST_A",
      "title": "Catat Panen",
      "data": {
        "harvest_title": {
          "type": "string",
          "__example__": "Catat panen · A1"
        },
        "min_date": {
          "type": "string",
          "__example__": "2026-08-01"
        },
        "max_date": {
          "type": "string",
          "__example__": "2026-10-04"
        },
        "init_values": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string"
            }
          },
          "__example__": {
            "date": "2026-10-04"
          }
        },
        "needs_confirm": {
          "type": "boolean",
          "__example__": false
        },
        "warned": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "harvest_a_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.harvest_title}"
              },
              {
                "type": "TextBody",
                "text": "Langkah 1 dari 2: berapa buah yang dipanen dari pohon ini?"
              },
              {
                "type": "DatePicker",
                "name": "date",
                "label": "Tanggal panen",
                "required": true,
                "helper-text": "Pilih hari buah dipanen.",
                "min-date": "${data.min_date}",
                "max-date": "${data.max_date}"
              },
              {
                "type": "TextInput",
                "name": "fruits",
                "label": "Jumlah buah dipanen",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Angka bulat 1 sampai 500, contoh: 12.",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "weight",
                "label": "Berat total (kg), boleh kosong",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Timbang semua buah sekaligus. Contoh: 24,5.",
                "required": false
              },
              {
                "type": "OptIn",
                "name": "confirm",
                "label": "Ya, sudah benar",
                "required": false,
                "visible": "${data.needs_confirm}"
              },
              {
                "type": "Footer",
                "label": "Lanjut",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "date": "${form.date}",
                    "fruits": "${form.fruits}",
                    "weight": "${form.weight}",
                    "confirm": "${form.confirm}",
                    "warned": "${data.warned}"
                  }
                }
              }
            ],
            "init-values": "${data.init_values}"
          }
        ]
      }
    },
    {
      "id": "HARVEST_B",
      "title": "Mutu Panen",
      "data": {
        "harvest_b_title": {
          "type": "string",
          "__example__": "Mutu panen · A1"
        },
        "harvest_summary": {
          "type": "string",
          "__example__": "Panen: 12 buah · 24 kg · 4 Okt 2026"
        },
        "grade_help": {
          "type": "string",
          "__example__": "Extra = bentuk dan matang sempurna. Jumlah semua kelas tidak boleh melebihi 12 buah."
        },
        "date": {
          "type": "string",
          "__example__": "2026-10-04"
        },
        "fruits": {
          "type": "string",
          "__example__": "12"
        },
        "weight": {
          "type": "string",
          "__example__": "24"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "harvest_b_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.harvest_b_title}"
              },
              {
                "type": "TextCaption",
                "text": "${data.harvest_summary}"
              },
              {
                "type": "TextBody",
                "text": "Langkah 2 dari 2: kelas mutu. Boleh dilewati, tetapi sangat membantu pemilik."
              },
              {
                "type": "TextCaption",
                "text": "${data.grade_help}"
              },
              {
                "type": "TextInput",
                "name": "extra",
                "label": "Extra (buah)",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Kosongkan jika 0",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "class1",
                "label": "Kelas I (buah)",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Kosongkan jika 0",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "class2",
                "label": "Kelas II (buah)",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Kosongkan jika 0",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "reject",
                "label": "Afkir (buah)",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Kosongkan jika 0",
                "required": false
              },
              {
                "type": "CheckboxGroup",
                "name": "problems",
                "label": "Masalah mutu yang ditemukan",
                "description": "Pilih semua yang sesuai. Kosongkan jika tidak ada.",
                "required": false,
                "data-source": [
                  {
                    "id": "wet_core",
                    "title": "Inti basah"
                  },
                  {
                    "id": "uneven",
                    "title": "Tidak merata"
                  },
                  {
                    "id": "rot",
                    "title": "Busuk"
                  },
                  {
                    "id": "crack",
                    "title": "Retak"
                  },
                  {
                    "id": "borer",
                    "title": "Penggerek"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "problem_fruits",
                "label": "Berapa buah yang bermasalah?",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Isi jika memilih masalah di atas.",
                "required": false
              },
              {
                "type": "TextSubheading",
                "text": "Foto (boleh dilewati)"
              },
              {
                "type": "TextCaption",
                "text": "Foto buah yang dipanen, atau buah yang bermasalah. Maksimal 3 foto."
              },
              {
                "type": "PhotoPicker",
                "name": "photos",
                "label": "Ambil atau pilih foto",
                "photo-source": "camera_gallery",
                "max-file-size-kb": 10240,
                "min-uploaded-photos": 0,
                "max-uploaded-photos": 3
              },
              {
                "type": "TextInput",
                "name": "note",
                "label": "Catatan (boleh kosong)",
                "label-variant": "large",
                "input-type": "text",
                "required": false,
                "max-chars": 200
              },
              {
                "type": "Footer",
                "label": "Kirim Panen",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "date": "${data.date}",
                    "fruits": "${data.fruits}",
                    "weight": "${data.weight}",
                    "extra": "${form.extra}",
                    "class1": "${form.class1}",
                    "class2": "${form.class2}",
                    "reject": "${form.reject}",
                    "problems": "${form.problems}",
                    "problem_fruits": "${form.problem_fruits}",
                    "photos": "${form.photos}",
                    "note": "${form.note}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "EDIT_TREE",
      "title": "Ubah Data Pohon",
      "data": {
        "edit_title": {
          "type": "string",
          "__example__": "Ubah data A1 · MK · Blok A"
        },
        "init_values": {
          "type": "object",
          "properties": {
            "canopy": {
              "type": "string"
            },
            "trunk": {
              "type": "string"
            },
            "branches": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "__example__": {
            "canopy": "520",
            "trunk": "43",
            "branches": "2",
            "notes": "Catatan pohon"
          }
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "edit_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.edit_title}"
              },
              {
                "type": "TextBody",
                "text": "Nilai saat ini sudah terisi. Ubah hanya yang berbeda; yang lain tetap tersimpan."
              },
              {
                "type": "TextInput",
                "name": "canopy",
                "label": "Lebar kanopi (cm)",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Ukur sisi terlebar, 50-2500 cm. Contoh: 520",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "trunk",
                "label": "Lingkar batang (cm)",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Ukur setinggi dada, 1-600 cm. Contoh: 43",
                "required": false
              },
              {
                "type": "TextInput",
                "name": "branches",
                "label": "Dahan berbunga",
                "label-variant": "large",
                "input-type": "number",
                "helper-text": "Jumlah dahan yang sedang berbunga. Contoh: 3",
                "required": false
              },
              {
                "type": "TextCaption",
                "text": "Tandan bunga dan jumlah buah dicatat lewat menu hitung, supaya riwayatnya tersimpan."
              },
              {
                "type": "TextArea",
                "name": "notes",
                "label": "Catatan",
                "label-variant": "large",
                "helper-text": "Kosongkan untuk menghapus catatan",
                "required": false,
                "max-length": 500
              },
              {
                "type": "Footer",
                "label": "Simpan Perubahan",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "canopy": "${form.canopy}",
                    "trunk": "${form.trunk}",
                    "branches": "${form.branches}",
                    "notes": "${form.notes}"
                  }
                }
              }
            ],
            "init-values": "${data.init_values}"
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "Selesai",
      "terminal": true,
      "success": true,
      "data": {
        "title": {
          "type": "string",
          "__example__": "✅ Laporan tersimpan"
        },
        "message": {
          "type": "string",
          "__example__": "Laporan untuk A1 tersimpan."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.title}"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Tutup",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
