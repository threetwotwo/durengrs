          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.title}"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Tutup",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "saved": "${data.saved}",
                "report_id": "${data.report_id}",
                "message": "${data.message}"
              }
            }
          }
        ]
      }
    }
  ]
}
