{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "REPORT": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "REPORT",
      "title": "Laporan Pohon",
      "data": {
        "report_title": {
          "type": "string",
          "__example__": "Laporan untuk A1 · MK · Blok A"
        },
        "condition_caption": {
          "type": "string",
          "__example__": "Kondisi saat ini: Hijau"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "report_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "${data.report_title}"
              },
              {
                "type": "TextCaption",
                "text": "${data.condition_caption}"
              },
              {
                "type": "TextBody",
                "text": "Foto pohon, lalu tulis apa yang Anda lihat atau kerjakan: bunga, buah, hama, penyakit, perawatan (semprot, oles, pupuk), atau panen. Sistem membaca foto dan tulisan Anda."
              },
              {
                "type": "TextSubheading",
                "text": "1. Foto"
              },
              {
                "type": "TextCaption",
                "text": "Satu foto dari dekat, satu foto seluruh pohon. Terang dan tidak buram."
              },
              {
                "type": "PhotoPicker",
                "name": "photos",
                "label": "Ambil atau pilih foto",
                "description": "Minimal 1 foto",
                "photo-source": "camera_gallery",
                "max-file-size-kb": 10240,
                "min-uploaded-photos": 1,
                "max-uploaded-photos": 3
              },
              {
                "type": "TextSubheading",
                "text": "2. Apa yang Anda lihat?"
              },
              {
                "type": "TextArea",
                "name": "description",
                "label": "Tulis dengan kata-kata Anda",
                "label-variant": "large",
                "helper-text": "Contoh: bunga mulai mekar; 40 buah sebesar telor; batang sudah dioles",
                "required": true,
                "max-length": 600
              },
              {
                "type": "Footer",
                "label": "Kirim Laporan",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "description": "${form.description}",
                    "photos": "${form.photos}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "Selesai",
      "terminal": true,
      "success": true,
      "data": {
        "title": {
          "type": "string",
          "__example__": "✅ Laporan tersimpan"
        },
        "message": {
          "type": "string",
          "__example__": "Laporan untuk A1 tersimpan."
        },
        "saved": {
          "type": "boolean",
          "__example__": true
        },
        "report_id": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.title}"
          },
          {
            "type": "TextBody",
            "text": "${data.message}"
          },
          {
            "type": "Footer",
            "label": "Tutup",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "saved": "${data.saved}",
                "report_id": "${data.report_id}"
              }
            }
          }
        ]
      }
    }
  ]
}
